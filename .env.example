# Postgres provider (Neon pooled / Supabase Supavisor session pooler / Railway Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

SESSION_SECRET=change-me-to-32-random-bytes
NODE_ENV=production
PORT=3000

# Seeded admin (change after first login)
ADMIN_EMAIL=admin@marketedge.com
ADMIN_PASSWORD=ChangeMe!2026

# Price worker
PRICE_POLL_MS=15000
PRICE_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,LTCUSDT

BRAND_NAME=Marketedge
BRAND_DOMAIN=marketedge.com

# Mail — OPTIONAL. Preferred: configure SMTP from the admin UI
# (System → Mail settings), which stores credentials in the database.
# These env vars are a fallback / infrastructure-as-code alternative.
# SMTP_URL=smtps://user:pass@smtp.gmail.com
# MAIL_FROM=Marketedge <no-reply@marketedge.com>

# Support inbox (contact form destination) and Smartsupp live-chat key.
# Both are editable at runtime in the admin UI (System → Site settings);
# these env vars only set the initial defaults.
# SUPPORT_EMAIL=marketedgesupport@gmail.com
# SMARTSUPP_KEY=your-smartsupp-key

# Google reCAPTCHA v3 — required for login, register and contact forms
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Receipt uploads — point at a persistent volume mount in production
# (e.g. /data/uploads). Defaults to public/uploads (ephemeral on Railway).
# UPLOAD_DIR=/data/uploads
