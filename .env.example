# Postgres provider (Neon pooled / Supabase Supavisor session pooler / Railway Postgres)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

SESSION_SECRET=change-me-to-32-random-bytes
NODE_ENV=production
PORT=3000

# Seeded admin (change after first login)
ADMIN_EMAIL=admin@marketedge.com
ADMIN_PASSWORD=ChangeMe!2026

# Price worker
PRICE_POLL_MS=15000
PRICE_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,LTCUSDT

BRAND_NAME=Marketedge
BRAND_DOMAIN=marketedge.com

# Mail — OPTIONAL. Preferred: one SMTP_URL (a whole config in a single var),
# or discrete SMTP_HOST/PORT/USER/PASS. Either is applied to the database at
# boot with zero admin-UI visits; admin UI saves always win.
# SMTP_URL=smtps://marketedgesupport@gmail.com:app-password@smtp.gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=marketedgesupport@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   # Gmail App Password
# SMTP_FROM=marketedgesupport@gmail.com
# MAIL_FROM_NAME=Marketedge Support

# Support inbox (contact form destination). Editable at runtime in the admin
# UI (System → Site settings); this env var only sets the initial default.
# SUPPORT_EMAIL=marketedgesupport@gmail.com
# (Live chat is built-in — no external key needed.)

# Google reCAPTCHA v3 — required for login, register and contact forms
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Receipt uploads — point at a persistent volume mount in production
# (e.g. /data/uploads). Defaults to public/uploads (ephemeral on Railway).
# UPLOAD_DIR=/data/uploads
