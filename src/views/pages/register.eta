<div class="card auth-card">
  <div class="auth-head">
    <h2>Open an account</h2>
    <p class="small">Takes about two minutes. You can fund it later.</p>
  </div>

  <% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>
  <% const f = it.f || {} %>

  <form method="post" action="/register" class="recaptcha-form" data-action="register">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <input type="hidden" name="g-recaptcha-response" class="recaptcha-token">

    <div class="row2">
      <div class="field">
        <label for="fn">First name</label>
        <div class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <input class="input" id="fn" name="firstName" required autocomplete="given-name" value="<%= f.firstName || '' %>" placeholder="Jane">
        </div>
      </div>
      <div class="field">
        <label for="ln">Last name</label>
        <div class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <input class="input" id="ln" name="lastName" required autocomplete="family-name" value="<%= f.lastName || '' %>" placeholder="Doe">
        </div>
      </div>
    </div>
    <div class="field">
      <label for="em">Email</label>
      <div class="input-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 7l8.5 5.5a2 2 0 002 0L21 7"/></svg>
        <input class="input" id="em" name="email" type="email" required autocomplete="email" value="<%= f.email || '' %>" placeholder="you@example.com">
      </div>
    </div>
    <div class="row2">
      <div class="field">
        <label for="co">Country</label>
        <div class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 000 20 15 15 0 000-20"/></svg>
          <input class="input" id="co" name="country" autocomplete="country-name" value="<%= f.country || '' %>" placeholder="United States">
        </div>
      </div>
      <div class="field">
        <label for="ph">Phone</label>
        <div class="input-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.63A2 2 0 014.11 2h3a2 2 0 012 1.72 12.3 12.3 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.3 12.3 0 002.81.7 2 2 0 011.72 2z"/></svg>
          <input class="input" id="ph" name="phone" type="tel" autocomplete="tel" value="<%= f.phone || '' %>" placeholder="+1 234 567 890">
        </div>
      </div>
    </div>
    <div class="field">
      <label for="pw">Password</label>
      <div class="input-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M8 9V7a4 4 0 018 0v2"/></svg>
        <input class="input" id="pw" name="password" type="password" required minlength="10" autocomplete="new-password" placeholder="Create a strong password">
      </div>
      <div class="hint">At least 10 characters. A short phrase works better than a scrambled word.</div>
    </div>
    <div class="field">
      <label for="cf">Confirm password</label>
      <div class="input-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="2"/><path d="M8 9V7a4 4 0 018 0v2"/></svg>
        <input class="input" id="cf" name="confirm" type="password" required autocomplete="new-password" placeholder="Repeat your password">
      </div>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Create account</button>
  </form>

  <p class="small center auth-switch">
    Already registered? <a href="/login">Log in</a>
  </p>
</div>
