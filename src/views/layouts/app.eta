<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> — <%= it.brand.name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<link rel="icon" href="/img/mark.svg" type="image/svg+xml">
<script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
</head>
<body>
<div class="app">

  <aside class="side">
    <a class="logo" href="/">
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="#3B7BFF"/><path d="M8 22L13 13l4 5 3-4 4 8" stroke="#F5B82E" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= it.brand.name %>
    </a>

    <% it.nav.forEach(function(group){ %>
      <div class="side-grp"><%= group.label %></div>
      <% group.items.forEach(function(i){ %>
        <a href="<%= i.href %>" <%= it.path === i.href || (i.href !== '/dashboard' && it.path.startsWith(i.href)) ? 'aria-current=page' : '' %>>
          <%~ i.icon %>
          <span><%= i.label %></span>
          <% if (i.tag) { %><span class="tag"><%= i.tag %></span><% } %>
        </a>
      <% }) %>
    <% }) %>

    <div class="side-grp">Account</div>
    <a href="/dashboard/account" <%= it.path === '/dashboard/account' || it.path.startsWith('/dashboard/account/') ? 'aria-current=page' : '' %>>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0116 0"/></svg>
      <span>Account</span>
    </a>
    <a href="/dashboard/settings" <%= it.path === '/dashboard/settings' ? 'aria-current=page' : '' %>>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-2.7 1.1V21a2 2 0 11-4 0v-.1A1.6 1.6 0 006 19.4l-.1.1a2 2 0 11-2.8-2.8l.1-.1A1.6 1.6 0 003 15H3a2 2 0 110-4h.1A1.6 1.6 0 004.6 6l-.1-.1a2 2 0 112.8-2.8l.1.1A1.6 1.6 0 009 3.6V3a2 2 0 114 0v.1A1.6 1.6 0 0018 4.6l.1-.1a2 2 0 112.8 2.8l-.1.1A1.6 1.6 0 0021 9h0a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"/></svg>
      <span>Settings</span>
    </a>
    <form method="post" action="/logout" style="margin:6px 0 24px">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <button class="side" type="submit" style="all:unset;display:flex;align-items:center;gap:11px;padding:10px 20px;color:var(--text-2);font-size:.91rem;cursor:pointer;width:100%;box-sizing:border-box">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        <span>Log out</span>
      </button>
    </form>
  </aside>

  <div class="main">
    <div class="topbar">
      <button data-side-toggle aria-label="Menu" style="all:unset;cursor:pointer;padding:8px" class="nav-toggle">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>

      <div class="balance-chip" hx-get="/dashboard/partials/balance" hx-trigger="every 20s" hx-swap="innerHTML">
        <span>Available balance</span>
        <b class="num" data-watch><%= it.usd(it.bal.available) %></b>
      </div>

      <div style="margin-left:auto;display:flex;align-items:center;gap:14px">
        <a href="/dashboard/notifications" style="position:relative;display:grid;place-items:center;width:36px;height:36px;border-radius:9px;border:1px solid var(--line)" aria-label="Notifications">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 01-3.4 0"/></svg>
          <% if (it.unread) { %>
            <span style="position:absolute;top:-6px;right:-6px;background:var(--down);color:#fff;font-size:.62rem;font-weight:700;min-width:17px;height:17px;border-radius:9px;display:grid;place-items:center;padding:0 4px"><%= it.unread > 99 ? '99+' : it.unread %></span>
          <% } %>
        </a>
        <div style="display:flex;align-items:center;gap:10px">
          <div class="avatar" style="width:34px;height:34px;font-size:.8rem"><%= it.initials(it.user.firstName, it.user.lastName) %></div>
          <div style="line-height:1.25">
            <div style="font-size:.88rem;font-weight:600"><%= it.user.firstName %> <%= it.user.lastName %></div>
            <div style="font-size:.72rem;color:var(--text-3)"><%= it.user.role === 'admin' ? 'Administrator' : 'Trading account' %></div>
          </div>
        </div>
      </div>
    </div>

    <main class="content"><%~ it.body %></main>
  </div>
</div>
<script src="/js/app.js" defer></script>
</body>
</html>
