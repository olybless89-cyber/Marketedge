<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.title %> — <%= it.brand.name %></title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<link rel="icon" href="/img/mark.svg" type="image/svg+xml">
</head>
<body>
<div style="min-height:100vh;display:grid;place-items:center;padding:34px 18px;position:relative;overflow:hidden">
  <div style="position:absolute;width:760px;height:760px;top:-330px;left:50%;transform:translateX(-50%);background:radial-gradient(circle,rgba(47,107,255,.15),rgba(255,200,61,.06) 40%,transparent 62%);pointer-events:none"></div>
  <div style="width:100%;max-width:440px;position:relative">
    <a class="logo" href="/" style="justify-content:center;margin-bottom:24px">
      <svg class="logo-mark" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="#2F6BFF"/><path d="M8 22L13 13l4 5 3-4 4 8" stroke="#FFC83D" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= it.brand.name %>
    </a>
    <%~ it.body %>
  </div>
</div>
</body>
</html>
