<div class="page-head"><div><h1>Send mail</h1>
  <p class="small" style="margin:4px 0 0">Compose an email to one client or broadcast to every active client. Registered recipients also get an in-app notification. Everything lands in the <a href="/admin/mail">outbox</a>.</p></div></div>

<% if (it.ok) { %><div class="notice notice-ok">Mail queued for <%= it.n %> recipient<%= Number(it.n) === 1 ? '' : 's' %>. Delivery status is tracked in the <a href="/admin/mail">outbox</a>.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="card" style="max-width:720px">
  <div class="card-head"><h3>Compose</h3></div>
  <form method="post" action="/admin/mail/compose">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">

    <div class="field"><label>Send to</label>
      <label class="row" style="gap:8px;align-items:center;margin-bottom:8px">
        <input type="radio" name="audience" value="one" checked>
        <span>One client</span>
      </label>
      <label class="row" style="gap:8px;align-items:center">
        <input type="radio" name="audience" value="all">
        <span>All active clients (<%= it.rows.length %>)</span>
      </label>
    </div>

    <div class="field"><label for="to">Recipient email <span class="muted">(one client only)</span></label>
      <input class="input" id="to" name="to" type="email" list="client-emails" value="<%= it.to %>" placeholder="client@example.com">
      <datalist id="client-emails">
        <% it.rows.forEach(function(r){ %><option value="<%= r.email %>"><%= r.first_name %> <%= r.last_name %></option><% }) %>
      </datalist>
      <div class="hint">Start typing to search registered clients. Ignored when broadcasting.</div></div>

    <div class="field"><label for="subject">Subject</label>
      <input class="input" id="subject" name="subject" value="<%= it.subject %>" maxlength="180" required placeholder="Scheduled maintenance this Sunday"></div>

    <div class="field"><label for="message">Message</label>
      <textarea class="input" id="message" name="message" rows="9" required placeholder="Write in plain text. Blank lines start a new paragraph."></textarea>
      <div class="hint">Plain text only — links are fine, HTML is escaped. Signed automatically as the <%= it.brand ? it.brand.name : 'Marketedge' %> team.</div></div>

    <button class="btn btn-primary btn-block btn-sm" data-confirm="Send this email now?">Send mail</button>
  </form>
</div>
