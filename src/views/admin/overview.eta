<div class="page-head"><div><h1>Admin</h1>
  <p class="small" style="margin:4px 0 0">Platform position as of right now.</p></div></div>

<div class="grid g4" style="margin-bottom:22px">
  <div class="stat"><div class="stat-k">Registered users</div><div class="stat-v"><%= it.k.users %></div>
    <div class="stat-sub"><%= it.k.new_users %> joined in the last 7 days</div></div>
  <div class="stat"><div class="stat-k">Deposits confirmed</div><div class="stat-v"><%= it.usd(it.k.deposits) %></div>
    <div class="stat-sub"><%= it.usd(it.k.withdrawals) %> withdrawn</div></div>
  <div class="stat"><div class="stat-k">Awaiting review</div><div class="stat-v <%= Number(it.k.pending) ? 'down':'' %>"><%= it.k.pending %></div>
    <div class="stat-sub"><%= it.usd(it.k.pending_value) %> in the queue</div></div>
  <div class="stat"><div class="stat-k">Capital in plans</div><div class="stat-v"><%= it.usd(it.k.staked) %></div>
    <div class="stat-sub"><%= it.k.active_plans %> active · <%= it.k.open_trades %> open trades</div></div>
</div>

<div class="card-head"><h3 style="font-family:var(--f-display)">Review queue</h3>
  <div style="display:flex;gap:8px"><a class="btn btn-quiet btn-sm" href="/admin/deposits">Deposits</a>
  <a class="btn btn-quiet btn-sm" href="/admin/withdrawals">Withdrawals</a></div></div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Requested</th><th>Client</th><th>Type</th><th>Method</th><th class="num">Amount</th><th></th></tr></thead>
    <tbody>
      <% if (!it.queue.length) { %>
        <tr><td colspan="6"><div class="empty"><h4>Queue is clear</h4>
          <p class="small">New deposit and withdrawal requests appear here.</p></div></td></tr>
      <% } %>
      <% it.queue.forEach(function(t){ %>
        <tr>
          <td class="small muted"><%= it.ago(t.created_at) %></td>
          <td><b><%= t.first_name %> <%= t.last_name %></b><div class="small muted"><%= t.email %></div></td>
          <td><span class="badge <%= t.type==='deposit'?'badge-live':'badge-warn' %>"><%= t.type %></span></td>
          <td class="small"><%= t.method.replace('_',' ').toUpperCase() %></td>
          <td class="num"><%= it.usd(t.amount) %></td>
          <td style="text-align:right"><a class="btn btn-quiet btn-sm" href="/admin/<%= t.type %>s">Review</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
