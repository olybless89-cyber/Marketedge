<div class="page-head"><div><h1>Mail outbox</h1>
  <p class="small" style="margin:4px 0 0">Every mail the system generates is logged here. Status <b>logged</b> means recorded but SMTP is not configured; <b>sent</b> means delivered; <b>failed</b> can be retried below.</p></div>
  <a class="btn btn-primary btn-sm" href="/admin/mail/compose">Compose mail</a></div>

<% if (it.retried === 'sent') { %><div class="notice notice-ok">Resent successfully.</div><% } %>
<% if (it.retried === 'failed') { %><div class="notice notice-err">Retry failed — check mail settings.</div><% } %>

<div class="table-wrap">
  <table>
    <thead><tr><th>When</th><th>Recipient</th><th>Template</th><th>Subject</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% if (!it.rows.length) { %>
        <tr><td colspan="6"><div class="empty"><h4>No mail sent yet</h4>
          <p class="small">Registration, deposit, withdrawal, plan and KYC mails appear here.</p></div></td></tr>
      <% } %>
      <% it.rows.forEach(function(m){ %>
        <tr>
          <td class="small muted"><%= it.ago(m.created_at) %></td>
          <td><b><%= m.first_name ? m.first_name + ' ' + m.last_name : '—' %></b>
            <div class="small muted"><%= m.to_email %></div></td>
          <td class="small num"><%= m.template.replace('mail/','') %></td>
          <td class="small"><%= m.subject %><% if (m.error) { %><div class="small" style="color:var(--down)"><%= m.error %></div><% } %></td>
          <td><span class="badge <%= m.status==='sent'?'badge-live':m.status==='failed'?'badge-warn':'badge-idle' %>"><%= m.status %></span></td>
          <td style="text-align:right">
            <% if (m.status === 'failed') { %>
              <form method="post" action="/admin/mail/<%= m.id %>/retry" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button class="btn btn-quiet btn-sm">Retry</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
