<% const TYPES = [['crypto','Cryptocurrency'],['bank','Bank transfer'],['mobile','Mobile money'],['giftcard','Gift card'],['gateway','Payment gateway'],['manual','Manual payment'],['other','Other']]; %>

<div class="page-head"><div><h1>Payment methods</h1>
  <p class="small" style="margin:4px 0 0">Funding and withdrawal methods clients see. Limits, fees, directions and required fields are per-method — no code changes needed.</p></div></div>

<% if (it.ok === '1') { %><div class="notice notice-ok">Saved.</div><% } %>
<% if (it.ok === 'archived') { %><div class="notice notice-ok">Method archived — it has transactions, so it was deactivated instead of deleted.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<details class="card" style="margin-bottom:20px">
  <summary style="cursor:pointer;padding:4px 0"><b>Add new method</b></summary>
  <form method="post" action="/admin/payment-methods" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <%~ include('../partials/pm-form', { m: null, TYPES }) %>
    <button class="btn btn-primary btn-sm">Create method</button>
  </form>
</details>

<div class="card">
  <div class="table-wrap" style="border:0">
    <table>
      <thead><tr><th>Method</th><th>Type</th><th>Used for</th><th>Limits</th><th>Fees</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (!it.methods.length) { %><tr><td colspan="7" class="muted small">No methods yet.</td></tr><% } %>
        <% it.methods.forEach(function(m){ %>
          <tr>
            <td><b><%= m.name %></b><div class="small muted" style="font-family:var(--f-mono)"><%= m.slug %></div></td>
            <td class="small"><%= (TYPES.find(function(t){return t[0]===m.type})||['','Other'])[1] %></td>
            <td class="small">
              <% if (m.depositEnabled) { %><span class="badge badge-live">Deposit</span><% } %>
              <% if (m.withdrawalEnabled) { %><span class="badge badge-live">Withdrawal</span><% } %>
            </td>
            <td class="small">
              Dep: <%= it.usd(m.minDeposit) %><% if (m.maxDeposit) { %>–<%= it.usd(m.maxDeposit) %><% } %><br>
              Wdr: <%= it.usd(m.minWithdrawal) %><% if (m.maxWithdrawal) { %>–<%= it.usd(m.maxWithdrawal) %><% } %>
            </td>
            <td class="small">
              <% if (Number(m.feeFixed)) { %>$<%= Number(m.feeFixed).toFixed(2) %> fixed<% } %>
              <% if (Number(m.feePercent)) { %><%= Number(m.feePercent) %>%<% } %>
              <% if (!Number(m.feeFixed) && !Number(m.feePercent)) { %>—<% } %>
            </td>
            <td>
              <% if (m.archived) { %><span class="badge badge-warn">archived</span>
              <% } else { %><span class="badge <%= m.enabled?'badge-live':'badge-idle' %>"><%= m.enabled?'active':'disabled' %></span><% } %>
            </td>
            <td class="small"><a class="go" href="#pm-<%= m.id %>">Edit ↓</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% it.methods.forEach(function(m){ %>
  <details class="card" id="pm-<%= m.id %>" style="margin-top:16px">
    <summary style="cursor:pointer;padding:4px 0"><b><%= m.name %></b> <span class="small muted">(<%= m.slug %>)</span></summary>
    <form method="post" action="/admin/payment-methods/<%= m.id %>" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <%~ include('../partials/pm-form', { m, TYPES }) %>
      <div class="row" style="gap:8px;flex-wrap:wrap">
        <button class="btn btn-primary btn-sm">Save changes</button>
        <button class="btn btn-ghost btn-sm" name="_action" value="delete"
                data-confirm="<%= m.archived ? 'Remove' : 'Deactivate' %> <%= m.name %>? Methods with transaction history are archived, not deleted.">Delete / archive</button>
      </div>
    </form>
  </details>
<% }) %>
