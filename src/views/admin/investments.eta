<div class="page-head"><div><h1>Investments</h1>
  <p class="small" style="margin:4px 0 0">Ending a plan early returns its principal and whatever has accrued so far to the client's balance.</p></div></div>

<% if (it.ok) { %><div class="notice notice-ok">Investment ended.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="tabs">
  <% ['active','ended','matured','cancelled','all'].forEach(function(s){ %>
    <a href="/admin/investments?status=<%= s %>" <%= it.status===s?'aria-current=page':'' %>><%= s.replace(/^./,x=>x.toUpperCase()) %></a>
  <% }) %>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Client</th><th>Plan</th><th class="num">Principal</th><th class="num">Accrued</th><th>Status</th><th>Started</th><th></th></tr></thead>
    <tbody>
      <% if (!it.rows.length) { %>
        <tr><td colspan="7"><div class="empty"><h4>No investments here</h4></div></td></tr>
      <% } %>
      <% it.rows.forEach(function(i){ %>
        <tr>
          <td><b><%= i.first_name %> <%= i.last_name %></b><div class="small muted"><%= i.email %></div></td>
          <td><%= i.plan_name %><div class="small muted"><%= Number(i.roi).toFixed(2) %>% / period</div></td>
          <td class="num" style="font-family:var(--ff-mono)"><%= it.usd(i.principal) %></td>
          <td class="num" style="font-family:var(--ff-mono)"><%= it.usd(i.accrued) %></td>
          <td><span class="badge <%= i.status==='active'?'badge-live':i.status==='ended'?'badge-warn':'badge-idle' %>"><%= i.status %></span></td>
          <td class="small muted"><%= it.dt(i.started_at) %></td>
          <td style="text-align:right">
            <% if (i.status === 'active') { %>
              <form method="post" action="/admin/investments/<%= i.id %>/end" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <input type="hidden" name="confirm" value="1">
                <button class="btn btn-danger btn-sm"
                  data-confirm="End <%= i.first_name %>'s &quot;<%= i.plan_name %>&quot; investment now? This returns <%= it.usd(Number(i.principal)+Number(i.accrued)) %> to their balance and cannot be undone.">
                  End investment
                </button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
