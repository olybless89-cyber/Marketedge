<div class="page-head"><h1>Investment plans</h1></div>
<% if (it.ok === '1') { %><div class="notice notice-ok">Plan created.</div><% } %>
<% if (it.ok === 'edit') { %><div class="notice notice-ok">Plan updated.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="grid" style="grid-template-columns:1.3fr .7fr;gap:20px">
  <div class="table-wrap" style="height:fit-content">
    <table>
      <thead><tr><th>Plan</th><th class="num">Rate</th><th>Term</th><th class="num">Range</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% if (!it.rows.length) { %><tr><td colspan="6"><div class="empty"><h4>No plans defined</h4></div></td></tr><% } %>
        <% it.rows.forEach(function(p){ %>
          <tr>
            <td><b><%= p.name %></b><div class="small muted"><%= p.slug %></div></td>
            <td class="num"><%= Number(p.roiPercent).toFixed(2) %>%</td>
            <td class="small"><%= p.durationPeriods %> × <%= p.periodHours %>h</td>
            <td class="num small"><%= it.usd(p.minAmount,0) %> – <%= it.usd(p.maxAmount,0) %></td>
            <td><span class="badge <%= p.active?'badge-live':'badge-idle' %>"><%= p.active?'live':'hidden' %></span></td>
            <td style="text-align:right;white-space:nowrap">
              <a class="btn btn-quiet btn-sm" href="/admin/plans#edit-<%= p.id %>">Edit</a>
              <form method="post" action="/admin/plans/<%= p.id %>/toggle" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= it.csrf %>">
                <button class="btn btn-quiet btn-sm"><%= p.active?'Hide':'Publish' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-head"><h3>Add a plan</h3></div>
    <form method="post" action="/admin/plans">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <div class="field"><label for="nm">Name</label><input class="input" id="nm" name="name" required placeholder="Standard"></div>
      <div class="row2">
        <div class="field"><label for="rp">Rate % per period</label><input class="input num" id="rp" name="roiPercent" type="number" step="0.01" value="1.20" required></div>
        <div class="field"><label for="ph">Period (hours)</label><input class="input num" id="ph" name="periodHours" type="number" value="24" required></div>
      </div>
      <div class="field"><label for="dp">Number of periods</label><input class="input num" id="dp" name="durationPeriods" type="number" value="30" required>
        <div class="hint">Rate × periods is the total return. Sanity-check it before publishing.</div></div>
      <div class="row2">
        <div class="field"><label for="mn">Minimum</label><input class="input num" id="mn" name="minAmount" type="number" value="100"></div>
        <div class="field"><label for="mx">Maximum</label><input class="input num" id="mx" name="maxAmount" type="number" value="25000"></div>
      </div>
      <button class="btn btn-primary btn-block btn-sm">Create plan</button>
    </form>
  </div>
</div>

<% it.rows.forEach(function(p){ %>
  <div class="card" id="edit-<%= p.id %>" style="margin-top:20px;max-width:680px">
    <div class="card-head"><h3>Edit — <%= p.name %></h3>
      <a class="btn btn-quiet btn-sm" href="/admin/plans">Close</a></div>
    <form method="post" action="/admin/plans/<%= p.id %>/edit">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <div class="field"><label for="enm-<%= p.id %>">Name</label><input class="input" id="enm-<%= p.id %>" name="name" value="<%= p.name %>" required></div>
      <div class="row2">
        <div class="field"><label for="erp-<%= p.id %>">Rate % per period</label><input class="input num" id="erp-<%= p.id %>" name="roiPercent" type="number" step="0.01" value="<%= Number(p.roiPercent) %>" required></div>
        <div class="field"><label for="eph-<%= p.id %>">Period (hours)</label><input class="input num" id="eph-<%= p.id %>" name="periodHours" type="number" value="<%= p.periodHours %>" required></div>
      </div>
      <div class="field"><label for="edp-<%= p.id %>">Number of periods</label><input class="input num" id="edp-<%= p.id %>" name="durationPeriods" type="number" value="<%= p.durationPeriods %>" required></div>
      <div class="row2">
        <div class="field"><label for="emn-<%= p.id %>">Minimum</label><input class="input num" id="emn-<%= p.id %>" name="minAmount" type="number" value="<%= Number(p.minAmount) %>"></div>
        <div class="field"><label for="emx-<%= p.id %>">Maximum</label><input class="input num" id="emx-<%= p.id %>" name="maxAmount" type="number" value="<%= Number(p.maxAmount) %>"></div>
      </div>
      <div class="field"><label for="eso-<%= p.id %>">Sort order</label><input class="input num" id="eso-<%= p.id %>" name="sortOrder" type="number" value="<%= p.sortOrder %>"></div>
      <button class="btn btn-primary btn-block btn-sm">Save plan</button>
    </form>
  </div>
<% }) %>

