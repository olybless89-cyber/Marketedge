<div class="page-head">
  <div><h1>Portfolio</h1>
    <p class="small" style="margin:4px 0 0">Every holding you have, valued at live market prices, on one page.</p></div>
</div>

<div class="grid g4" style="margin-bottom:22px">
  <div class="stat">
    <div class="stat-k">Total equity</div>
    <div class="stat-v"><%= it.usd(it.pf.equity + it.spotValue) %></div>
    <div class="stat-sub">Cash, locked capital, plans and spot positions</div>
  </div>
  <div class="stat">
    <div class="stat-k">Available</div>
    <div class="stat-v"><%= it.usd(it.pf.available) %></div>
    <div class="stat-sub">Free to trade, invest or withdraw</div>
  </div>
  <div class="stat">
    <div class="stat-k">Spot positions</div>
    <div class="stat-v"><%= it.usd(it.spotValue) %></div>
    <div class="stat-sub"><%= it.spots.filter(s => s.status === 'open').length %> open · <%= it.usd(it.pf.realised) %> realised</div>
  </div>
  <div class="stat">
    <div class="stat-k">In plans &amp; copy</div>
    <div class="stat-v"><%= it.usd(it.pf.staked + it.pf.exposure) %></div>
    <div class="stat-sub"><%= it.pf.activePlans %> plans · <%= it.pf.openTrades %> copy trades</div>
  </div>
</div>

<div class="grid grid-half" style="margin-bottom:22px">
  <div class="card">
    <div class="card-head"><h3>Spot positions</h3><a class="small" style="color:var(--blue-hi)" href="/dashboard/trade">Trade</a></div>
    <% if (it.spots.length) { %>
      <div class="table-wrap" style="margin:0">
        <table>
          <thead><tr><th>Asset</th><th class="num">Qty</th><th class="num">Value</th><th class="num">P&amp;L</th></tr></thead>
          <tbody>
            <% it.spots.forEach(function(p){ %>
              <tr>
                <td><b><%= p.symbol.replace(/USDT$/,'') %></b><div class="small muted num"><%= p.status %></div></td>
                <td class="num"><%= it.num(Number(p.qty),6) %></td>
                <td class="num"><%= it.usd(p.status==='open' ? p.value : 0) %></td>
                <td class="num <%= it.dir(p.status==='open' ? p.unrealised : Number(p.pnl)) %>"><%= it.signedUsd(p.status==='open' ? p.unrealised : Number(p.pnl)) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty" style="padding:24px 8px"><h4>No spot positions</h4><p class="small">Open one from the Trade page.</p></div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-head"><h3>Active plans</h3><a class="small" style="color:var(--blue-hi)" href="/dashboard/invest">Manage</a></div>
    <% if (it.invs.length) { %>
      <div style="display:grid;gap:13px">
        <% it.invs.forEach(function(i){ const d = Math.min(100,(i.periods_paid/i.duration_periods)*100||0); %>
          <div style="padding-bottom:13px;border-bottom:1px solid var(--line-soft)">
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:8px">
              <b style="font-size:.92rem"><%= i.plan_name %></b>
              <span class="num small up"><%= it.signedUsd(i.accrued) %></span>
            </div>
            <div class="small muted" style="display:flex;justify-content:space-between;margin:5px 0 4px">
              <span class="num"><%= it.usd(i.principal) %></span>
              <span class="num"><%= i.periods_paid %>/<%= i.duration_periods %></span>
            </div>
            <div class="meter"><i style="width:<%= d %>%"></i></div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty" style="padding:24px 8px"><h4>No active plans</h4><p class="small">Browse investment plans to put cash on a fixed term.</p></div>
    <% } %>
  </div>
</div>

<div class="card-head"><h3 style="font-family:var(--f-display)">Strategies you're copying</h3>
  <a class="small" style="color:var(--blue-hi)" href="/dashboard/copy">Manage copy trading</a></div>
<% if (it.copies.length) { %>
  <div class="grid g3">
    <% it.copies.forEach(function(t){ %>
      <div class="card">
        <div class="trader-head">
          <div class="avatar"><%= it.initials(t.displayName.split(' ')[0], t.displayName.split(' ')[1]) %></div>
          <div style="min-width:0;flex:1"><h3><%= t.displayName %></h3><div class="role"><%= t.strategy %></div></div>
          <span class="badge <%= t.openTrades ? 'badge-live' : 'badge-idle' %>"><%= t.openTrades ? 'In market' : 'Flat' %></span>
        </div>
        <dl class="kv">
          <dt>Allocated</dt><dd><%= it.usd(t.allocation) %></dd>
          <dt>Current value</dt><dd data-watch><%= it.usd(t.currentValue) %></dd>
          <dt>P&amp;L</dt><dd class="<%= it.dir(t.pnl) %>" data-watch><%= it.signedUsd(t.pnl) %></dd>
          <dt>Return</dt><dd class="<%= it.dir(t.roi) %>"><%= it.pct(t.roi) %></dd>
        </dl>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card empty"><h4>Not copying anyone yet</h4><p class="small">Mirror an established trader's positions automatically.</p></div>
<% } %>
