<div class="page-head">
  <div><h1>Change password</h1>
    <p class="small" style="margin:4px 0 0">Your password is stored as an Argon2id hash. We can't recover it — only replace it.</p></div>
  <a class="btn btn-quiet btn-sm" href="/dashboard/account">Back to account</a>
</div>

<% if (it.ok) { %><div class="notice notice-ok">Password changed. Use the new one next time you sign in.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="card" style="max-width:520px">
  <form method="post" action="/dashboard/account/password">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="field">
      <label for="cur">Current password</label>
      <input class="input" id="cur" name="current" type="password" autocomplete="current-password" required>
    </div>
    <div class="field">
      <label for="nw">New password</label>
      <input class="input" id="nw" name="next" type="password" autocomplete="new-password" minlength="8" required>
      <div class="small muted">At least 8 characters.</div>
    </div>
    <div style="display:flex;gap:10px;margin-top:6px">
      <button class="btn btn-primary">Update password</button>
      <a class="btn btn-quiet" href="/dashboard/account">Cancel</a>
    </div>
  </form>
</div>
