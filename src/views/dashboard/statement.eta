<div class="page-head">
  <div><h1>Account statement</h1>
    <p class="small" style="margin:4px 0 0">Every movement on your account, in order. Your balance is the sum of this list.</p></div>
</div>

<div class="grid g4" style="margin-bottom:20px">
  <div class="stat"><div class="stat-k">Deposited</div><div class="stat-v"><%= it.usd(it.pf.deposited) %></div></div>
  <div class="stat"><div class="stat-k">Withdrawn</div><div class="stat-v"><%= it.usd(it.pf.withdrawn) %></div></div>
  <div class="stat"><div class="stat-k">Realised P&amp;L</div><div class="stat-v <%= it.dir(it.pf.realised) %>"><%= it.signedUsd(it.pf.realised) %></div></div>
  <div class="stat"><div class="stat-k">Current balance</div><div class="stat-v"><%= it.usd(it.pf.total) %></div></div>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Date</th><th>Account</th><th>Activity</th><th>Reference</th><th class="num">Amount</th></tr></thead>
    <tbody>
      <% if (!it.rows.length) { %>
        <tr><td colspan="5"><div class="empty"><h4>Nothing to show yet</h4>
          <p class="small">Fund your account and the first line appears here.</p></div></td></tr>
      <% } %>
      <% it.rows.forEach(function(r){ %>
        <tr>
          <td class="small muted"><%= it.dt(r.createdAt) %></td>
          <td><span class="pill"><%= r.account %></span></td>
          <td><%= r.kind.replace(/_/g,' ').replace(/^./, s=>s.toUpperCase()) %></td>
          <td class="small muted"><%= r.memo || '—' %></td>
          <td class="num <%= it.dir(r.amount) %>"><%= it.signedUsd(r.amount) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
