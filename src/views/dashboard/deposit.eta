<div class="page-head"><h1>Deposit</h1></div>
<% if (it.sent) { %><div class="notice notice-ok">Deposit submitted with your receipt. Your balance updates once admin confirms the transfer.</div><% } %>
<% if (it.error) { %><div class="notice notice-err"><%= it.error %></div><% } %>

<div class="grid" style="grid-template-columns:.9fr 1.1fr;gap:20px">
  <div class="card">
    <div class="card-head"><h3>Fund your account</h3></div>
    <form method="post" action="/dashboard/deposit" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= it.csrf %>">
      <div class="field">
        <label for="m">Method</label>
        <select class="input" id="m" name="method" data-wallets='<%~ JSON.stringify(it.wallets || {}) %>'>
          <option value="usdt_trc20">USDT — TRC20</option>
          <option value="btc">Bitcoin</option>
          <option value="eth">Ethereum — ERC20</option>
          <option value="bank">Bank transfer</option>
        </select>
      </div>
      <div class="field">
        <label for="a">Amount (USD)</label>
        <input class="input num" id="a" name="amount" type="number" min="10" step="0.01" required placeholder="500.00">
        <div class="amount-presets" data-target="#a">
          <button type="button" data-amt="100">$100</button>
          <button type="button" data-amt="500">$500</button>
          <button type="button" data-amt="1000">$1,000</button>
          <button type="button" data-amt="5000">$5,000</button>
        </div>
        <div class="hint">Minimum deposit is $10. Network fees are paid by the sender.</div>
      </div>
      <div id="wallet-box" class="field" style="display:none">
        <label>Send to this address</label>
        <div style="display:flex;gap:8px;align-items:flex-start">
          <code id="wallet-addr" class="input num" style="white-space:pre-wrap;word-break:break-all;user-select:all"></code>
          <button type="button" class="btn btn-quiet btn-sm" data-copy="#wallet-addr">Copy</button>
        </div>
        <div class="hint">Only send the matching asset to this address. Other networks may lose funds.</div>
      </div>
      <div class="field">
        <label for="rc">Payment receipt</label>
        <input class="input" id="rc" name="receipt" type="file" accept="image/png,image/jpeg,image/webp,image/gif,application/pdf">
        <div class="hint">Upload a screenshot or photo of the transfer confirmation, or paste a link below.</div>
      </div>
      <div class="field">
        <label for="ru">…or receipt link</label>
        <input class="input" id="ru" name="receiptUrl" type="url" placeholder="https://…">
        <div class="hint">Used only if no file is attached. Admin reviews this to confirm your deposit.</div>
      </div>
      <button class="btn btn-primary btn-block">Submit deposit</button>
    </form>
  </div>

  <div class="card">
    <div class="card-head"><h3>Deposit history</h3></div>
    <div class="table-wrap" style="border:0">
      <table>
        <thead><tr><th>Date</th><th>Method</th><th class="num">Amount</th><th>Receipt</th><th>Status</th></tr></thead>
        <tbody>
          <% if (!it.rows.length) { %>
            <tr><td colspan="5"><div class="empty"><h4>No deposits yet</h4><p class="small">Your first transfer will appear here.</p></div></td></tr>
          <% } %>
          <% it.rows.forEach(function(r){ %>
            <tr>
              <td class="small muted"><%= it.ago(r.createdAt) %></td>
              <td class="small"><%= r.method.replace('_',' ').toUpperCase() %></td>
              <td class="num"><%= it.usd(r.amount) %></td>
              <td class="small"><% if (r.proofUrl) { %><a href="<%= r.proofUrl %>" target="_blank" rel="noopener" class="go">View</a><% } else { %><span class="muted">—</span><% } %></td>
              <td><span class="badge <%= r.status==='approved'?'badge-live':r.status==='rejected'?'badge-warn':'badge-idle' %>"><%= r.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
