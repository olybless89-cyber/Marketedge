<h1 style="margin:0 0 8px;font-family:Space Grotesk,Arial,sans-serif;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#fff">Deposit confirmed</h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#B8C5DA">Hi <%= it.firstName %>, your deposit has been credited to your account and is available now.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">
  <tr><td style="background:#0C1424;border:1px solid #1E2D4A;border-radius:10px;padding:18px 20px">
    <p style="margin:0 0 6px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#6B7C9B;font-weight:600">Amount credited</p>
    <p style="margin:0 0 14px;font-family:Space Grotesk,Arial,sans-serif;font-size:26px;font-weight:700;color:#16C784">$<%= it.amount.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
    <p style="margin:0;font-size:13px;color:#8FA0BD">Method: <%= it.method.replace('_',' ').toUpperCase() %></p>
  </td></tr>
</table>

<a href="<%= it.base %>/dashboard/deposit" style="display:inline-block;background:#2F6BFF;color:#fff;font-weight:600;font-size:14px;text-decoration:none;padding:13px 26px;border-radius:9px">View deposits</a>
