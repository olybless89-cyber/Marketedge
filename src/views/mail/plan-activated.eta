<h1 style="margin:0 0 8px;font-family:Space Grotesk,Arial,sans-serif;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#fff">Plan activated</h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#B8C5DA">Hi <%= it.firstName %>, your investment plan is now active and earning.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">
  <tr><td style="background:#0C1424;border:1px solid #1E2D4A;border-radius:10px;padding:18px 20px">
    <p style="margin:0 0 4px;font-size:13px;color:#8FA0BD">Plan</p>
    <p style="margin:0 0 14px;font-family:Space Grotesk,Arial,sans-serif;font-size:20px;font-weight:700;color:#fff"><%= it.planName %></p>
    <p style="margin:0 0 4px;font-size:13px;color:#8FA0BD">Principal invested</p>
    <p style="margin:0 0 14px;font-family:Space Grotesk,Arial,sans-serif;font-size:20px;font-weight:700;color:#16C784">$<%= it.amount.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
    <% if (it.maturesAt) { %><p style="margin:0;font-size:13px;color:#8FA0BD">Matures on <%= new Date(it.maturesAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) %></p><% } %>
  </td></tr>
</table>

<p style="margin:0 0 18px;font-size:13px;line-height:1.6;color:#6B7C9B">Returns post to your account each period and can be withdrawn at any time.</p>
<a href="<%= it.base %>/dashboard/invest" style="display:inline-block;background:#2F6BFF;color:#fff;font-weight:600;font-size:14px;text-decoration:none;padding:13px 26px;border-radius:9px">View investments</a>
