<h1 style="margin:0 0 8px;font-family:Space Grotesk,Arial,sans-serif;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#fff">Withdrawal request received</h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#B8C5DA">Hi <%= it.firstName %>, your withdrawal request is in the queue. The amount is held from your available balance while our team reviews it.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">
  <tr><td style="background:#060C20;border:1px solid #1B2D5C;border-radius:10px;padding:18px 20px">
    <p style="margin:0 0 6px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#7E8FBF;font-weight:600">Amount requested</p>
    <p style="margin:0 0 14px;font-family:Space Grotesk,Arial,sans-serif;font-size:26px;font-weight:700;color:#F5B82E">$<%= it.amount.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) %></p>
    <p style="margin:0;font-size:13px;color:#8FA0BD">Method: <%= it.method.replace('_',' ').toUpperCase() %> · Status: under review</p>
    <% if (it.address) { %><p style="margin:6px 0 0;font-size:13px;color:#8FA0BD;word-break:break-all">Destination: <%= it.address %></p><% } %>
  </td></tr>
</table>

<p style="margin:0 0 22px;font-size:13px;line-height:1.6;color:#8FA0BD">We'll email you when it's sent. If you didn't make this request, contact support immediately.</p>

<a href="<%= it.base %>/dashboard/withdraw" style="display:inline-block;background:linear-gradient(90deg,#3B7BFF 0%,#3B7BFF 55%,#F5B82E 100%);color:#080E26;font-weight:700;font-size:14px;text-decoration:none;padding:13px 26px;border-radius:9px">View withdrawals</a>
