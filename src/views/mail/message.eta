<h1 style="margin:0 0 8px;font-family:Space Grotesk,Arial,sans-serif;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#fff"><%= it.subject %></h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#B8C5DA">Hi <%= it.firstName %>,</p>

<% it.paragraphs.forEach(function(p){ %>
<p style="margin:0 0 16px;font-size:15px;line-height:1.7;color:#B8C5DA"><%~ p %></p>
<% }) %>

<p style="margin:6px 0 22px;font-size:15px;line-height:1.6;color:#B8C5DA">— The <%= it.name %> team</p>

<a href="<%= it.base %>/dashboard" style="display:inline-block;background:linear-gradient(90deg,#3B7BFF 0%,#3B7BFF 55%,#F5B82E 100%);color:#080E26;font-weight:700;font-size:14px;text-decoration:none;padding:13px 26px;border-radius:9px">Open your account</a>
