<h1 style="margin:0 0 8px;font-family:Space Grotesk,Arial,sans-serif;font-size:23px;font-weight:700;letter-spacing:-.02em;color:#fff">Contact form message</h1>
<p style="margin:0 0 20px;font-size:15px;line-height:1.6;color:#B8C5DA">A visitor sent a message through the contact form.</p>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">
  <tr><td style="background:#060C20;border:1px solid #1B2D5C;border-radius:10px;padding:18px 20px">
    <p style="margin:0 0 6px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#7E8FBF;font-weight:600">From</p>
    <p style="margin:0 0 4px;font-size:15px;font-weight:600;color:#fff"><%= it.name %></p>
    <p style="margin:0;font-size:13px;color:#8FA0BD"><a href="mailto:<%= it.email %>" style="color:#5A8CFF;text-decoration:none"><%= it.email %></a></p>
  </td></tr>
</table>

<table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px">
  <tr><td style="background:#060C20;border:1px solid #1B2D5C;border-radius:10px;padding:18px 20px">
    <p style="margin:0 0 8px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#7E8FBF;font-weight:600">Message</p>
    <% String(it.message).split(/\n/).forEach(function(l){ %>
    <p style="margin:0 0 6px;font-size:14px;line-height:1.6;color:#B8C5DA"><%= l || ' ' %></p>
    <% }) %>
  </td></tr>
</table>

<p style="margin:0;font-size:13px;line-height:1.6;color:#8FA0BD">Reply directly to <%= it.email %> from your support inbox.</p>
